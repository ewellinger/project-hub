    },
    {
      "id": "claim_f8730b0797ed404680652e6572bd50ca",
      "statement": "On GitLab the read runs three `glab api` GET calls concurrently (the merge request, its /approvals, and /discussions?per_page=100); only the merge request must answer, and failed approvals or discussions leave their fields unknown.",
      "evidence": [
