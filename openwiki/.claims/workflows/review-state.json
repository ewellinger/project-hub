    {
      "id": "claim_fb3efe01b61d443e9b5633c0d4f0d706",
      "statement": "Review state is read only for open changes in stage `review` of an open feature whose recorded review_url parses as a GitLab merge request or GitHub pull request URL; other roles are skipped without a warning.",
